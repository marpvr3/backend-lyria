{
  "BranchTimeZone": {
    "DefaultTimeZoneId": "America/Argentina/Buenos_Aires"
  },
  "ConnectionStrings": {
    "LyriaDatabase": "",
    "LoggingDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Lyria"
  },
  "EmailVerification": {
    "CodeSecret": "",
    "CodeLength": 6,
    "ExpirationMinutes": 15,
    "MaximumFailedAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "DatabaseLogging": {
    "Enabled": false,
    "ConnectionStringName": "LoggingDatabase",
    "TableName": "LogsAplicacion",
    "SchemaName": "dbo",
    "BatchPostingLimit": 50,
    "BatchPeriodSeconds": 5,
    "MaxBodyBytes": 16384,
    "RetentionDays": 60,
    "PersistClientErrors": true,
    "PersistServerErrors": true
  },
  "Jwt": {
    "Issuer": "Lyria.Api",
    "Audience": "Lyria.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "MobileRegistration": {
    "DefaultRoleId": "",
    "DefaultRestrictionImportanceLevel": "High"
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "EmailVerificationResend": {
      "PermitLimit": 3,
      "WindowSeconds": 900
    },
    "EmailVerificationConfirm": {
      "PermitLimit": 10,
      "WindowSeconds": 900
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lyria-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30,
          "shared": true,
          "flushToDiskInterval": "00:00:05",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  }
}
